function getSimTargets() {
  const active = places
    .filter(p => p.latitude && p.longitude)
    .slice()
    .sort((a, b) => (b.averageRating - a.averageRating) || (b.totalVisits - a.totalVisits) || (a.placeId - b.placeId));

  const mode = document.getElementById('sim-cluster')?.value || 'top4';
  if (mode === 'all') return active;
  const count = mode === 'top3' ? 3 : mode === 'top5' ? 5 : 4;
  return active.slice(0, Math.min(count, active.length));
}

function formatSimClock(date = new Date()) {
  return date.toLocaleTimeString([], { hour12: false });
}

function addSimLog(message, kind = 'info') {
  const entry = { at: formatSimClock(), message, kind };
  simState.log.push(entry);
  if (simState.log.length > 800) simState.log.shift();
  localStorage.setItem(simState.logKey, JSON.stringify(simState.log));
  renderSimLog();
}

function trackSimEvent(type, payload = {}) {
  const evt = {
    type,
    at: Date.now(),
    ...payload
  };
  simState.events.push(evt);
  if (simState.events.length > 1000) simState.events.shift();
  simState.test.metrics.totalEvents = simState.events.length;
}

function loadSimLog() {
  try {
    const raw = localStorage.getItem(simState.logKey);
    simState.log = raw ? JSON.parse(raw) : [];
  } catch {
    simState.log = [];
  }
}

function renderSimLog() {
  const box = document.getElementById('sim-log');
  if (!box) return;
  if (!simState.log.length) {
    box.innerHTML = '<div class="text-[#5f7c64]">[SIM] Geofence simulator ready.</div>';
    return;
  }
  box.innerHTML = simState.log.map(x => {
    const color = x.kind === 'error' ? 'text-red-300' : x.kind === 'success' ? 'text-emerald-300' : x.kind === 'meta' ? 'text-cyan-300' : 'text-[#8bf5a5]';
    return `<div class="sim-terminal-line ${color}"><span class="text-[#5f7c64]">${x.at}</span> | [SIM] ${escapeHtml(x.message)}</div>`;
  }).join('');
  box.scrollTop = box.scrollHeight;
}

function escapeHtml(text) {
  return String(text)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function fmtMs(value) {
  if (value == null || Number.isNaN(value)) return '—';
  return `${Math.round(value)} ms`;
}

function normalizeSeed(seed) {
  const n = Number(seed);
  if (Number.isFinite(n) && n > 0) return Math.floor(n);
  return 101;
}

function hashSeed(text) {
  const str = String(text ?? '101');
  let h = 2166136261;
  for (let i = 0; i < str.length; i += 1) {
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

function createSeededRng(seed) {
  let state = hashSeed(seed) || 1;
  return function next() {
    state += 0x6D2B79F5;
    let t = state;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function makeCheck(label, pass, actual, expected) {
  return { label, pass: !!pass, actual, expected };
}

function getScenarioSeedValue(scenario = null) {
  const input = document.getElementById('sim-seed');
  const fromInput = normalizeSeed(input?.value);
  if (Number.isFinite(fromInput) && fromInput > 0 && input?.value) return fromInput;
  return normalizeSeed(scenario?.seed ?? simState.seed ?? 101);
}

function setScenarioSeedValue(seed) {
  const input = document.getElementById('sim-seed');
  if (input) input.value = String(normalizeSeed(seed));
}

function calculateScenarioScore(checks) {
  if (!checks.length) return 0;
  const passCount = checks.filter(c => c.pass).length;
  return Math.round((passCount / checks.length) * 100);
}

function scoreLabelFromPercent(percent) {
  if (percent >= 100) return '10/10';
  if (percent >= 90) return '9/10';
  if (percent >= 80) return '8/10';
  if (percent >= 70) return '7/10';
  if (percent >= 60) return '6/10';
  if (percent >= 50) return '5/10';
  return `${Math.max(0, Math.round(percent / 10))}/10`;
}

function getScenarioCooldownMinutes() {
  return Number(simState.activeScenario?.cooldownMinutes ?? 30);
}

function getScenarioCooldownMs() {
  return Math.max(1000, getScenarioCooldownMinutes() * 60 * 1000);
}

function getScenario(id) {
  return simScenarios.find(s => s.id === id) || simScenarios[0];
}

function renderScenarioSelect() {
  const select = document.getElementById('sim-scenario-select');
  const desc = document.getElementById('sim-scenario-desc');
  if (!select) return;

  const current = select.value || simState.test.scenarioId || simScenarios[0].id;
  select.innerHTML = simScenarios.map(s => `<option value="${s.id}">${escapeHtml(s.name)}</option>`).join('');
  select.value = current;

  const scenario = getScenario(select.value);
  if (desc) desc.textContent = scenario.desc;
  if (simState.test.status !== 'RUNNING') setScenarioSeedValue(scenario.seed ?? simState.seed ?? 101);
}

function updateScenarioDescription(scenarioId) {
  const scenario = getScenario(scenarioId);
  const desc = document.getElementById('sim-scenario-desc');
  if (desc) desc.textContent = scenario.desc;
}

function renderScenarioBadge() {
  const badge = document.getElementById('sim-scenario-badge');
  if (!badge) return;
  const status = simState.test.status || 'IDLE';
  badge.textContent = status;
  badge.className = 'sim-chip ';
  if (status === 'PASS') badge.className += 'bg-emerald-500/15 text-emerald-300';
  else if (status === 'FAIL') badge.className += 'bg-rose-500/15 text-rose-300';
  else if (status === 'RUNNING') badge.className += 'bg-cyan-500/15 text-cyan-300';
  else badge.className += 'bg-white/5 text-[#f0e6d3]';
}

function renderSimSummary() {
  updateScenarioMetricsFromState();
  const badge = document.getElementById('sim-summary-badge');
  const scenarioLine = document.getElementById('sim-summary-scenario');
  const score = document.getElementById('sim-summary-score');
  const seed = document.getElementById('sim-summary-seed');
  const duration = document.getElementById('sim-summary-duration');
  const enters = document.getElementById('sim-summary-enters');
  const api = document.getElementById('sim-summary-api');
  const avg = document.getElementById('sim-summary-avg');
  const checks = document.getElementById('sim-summary-checks');
  if (!badge || !duration || !enters || !api || !avg || !checks || !scenarioLine || !score || !seed) return;

  const test = simState.test;
  scenarioLine.textContent = `Scenario: ${test.name || '—'}`;
  seed.textContent = String(test.seed ?? simState.seed ?? '—');
  const running = test.status === 'RUNNING';
  if (running) {
    badge.textContent = 'RUNNING';
    badge.className = 'sim-chip bg-cyan-500/15 text-cyan-300';
  } else if (test.status === 'PASS') {
    badge.textContent = 'PASS';
    badge.className = 'sim-chip bg-emerald-500/15 text-emerald-300';
  } else if (test.status === 'FAIL') {
    badge.textContent = 'FAIL';
    badge.className = 'sim-chip bg-rose-500/15 text-rose-300';
  } else {
    badge.textContent = 'NO RUN';
    badge.className = 'sim-chip bg-white/5 text-[#f0e6d3]';
  }

  duration.textContent = test.startedAt ? formatElapsed(test.startedAt, test.endedAt || Date.now()) : '—';
  enters.textContent = String(simState.totalEnters ?? 0);
  api.textContent = `${test.metrics.apiOk} ✓ / ${test.metrics.apiFail} ✕`;
  avg.textContent = fmtMs(test.metrics.avgLatencyMs);

  const passCount = test.checks.filter(c => c.pass).length;
  const percent = test.checks.length ? Math.round((passCount / test.checks.length) * 100) : 0;
  test.score = percent;
  score.textContent = test.checks.length ? `${scoreLabelFromPercent(percent)} (${percent}%)` : '—';

  if (!test.checks.length) {
    checks.innerHTML = '<div class="text-[#8d7a66]">Chưa chạy scenario nào.</div>';
    return;
  }

  checks.innerHTML = test.checks.map(check => `
    <div class="flex items-start gap-2 rounded-xl border px-3 py-2 ${check.pass ? 'border-emerald-500/20 bg-emerald-500/5 text-emerald-200' : 'border-rose-500/20 bg-rose-500/5 text-rose-200'}">
      <span class="mt-0.5 text-xs font-black">${check.pass ? 'PASS' : 'FAIL'}</span>
      <div class="min-w-0 flex-1">
        <div class="font-bold">${escapeHtml(check.label)}</div>
        <div class="text-[11px] text-current/75">Actual: ${escapeHtml(String(check.actual))} | Expected: ${escapeHtml(String(check.expected))}</div>
      </div>
    </div>
  `).join('');
}

function formatElapsed(start, end) {
  const ms = Math.max(0, (end || Date.now()) - start);
  const sec = Math.floor(ms / 1000);
  const min = Math.floor(sec / 60);
  const rem = sec % 60;
  return `${String(min).padStart(2, '0')}:${String(rem).padStart(2, '0')}`;
}

function metersToLatLng(lat, metersNorth, metersEast) {
  const latDelta = metersNorth / 111320;
  const lngDelta = metersEast / (111320 * Math.cos(lat * Math.PI / 180));
  return { latDelta, lngDelta };
}

function offsetLatLng(lat, lng, metersNorth, metersEast) {
  const delta = metersToLatLng(lat, metersNorth, metersEast);
  return { lat: lat + delta.latDelta, lng: lng + delta.lngDelta };
}

function makeSimDeviceIcon(color, label, selected = false) {
  const border = selected ? '#f0e6d3' : 'rgba(255,255,255,0.8)';
  const shadow = selected ? '0 0 0 4px rgba(200,169,110,0.16)' : '0 0 0 4px rgba(59,130,246,0.10)';
  return L.divIcon({
    className: '',
    html: `
      <div style="display:flex;flex-direction:column;align-items:center;gap:3px;transform:translateY(-4px);">
        <div style="padding:2px 7px;border-radius:999px;background:rgba(0,0,0,0.72);color:#fff;font-size:10px;font-weight:800;box-shadow:0 8px 20px rgba(0,0,0,0.18);white-space:nowrap">${label}</div>
        <div style="width:18px;height:18px;border-radius:50%;background:${color};border:3px solid ${border};box-shadow:${shadow}"></div>
      </div>`,
    iconSize: [32, 38],
    iconAnchor: [16, 34],
    popupAnchor: [0, -30]
  });
}

function initSimState() {
  if (!simEnabled) return;
  const targets = getSimTargets();
  if (!targets.length) return;

  const origin = targets[0];
  simState.currentClusterKey = targets.map(t => t.placeId).join(',');
  const deviceCount = simState.activeScenario?.deviceCount || 3;
  const rng = simState.rng || Math.random;
  simState.devices = Array.from({ length: deviceCount }, (_, idx) => {
    const angle = (idx / Math.max(1, deviceCount)) * Math.PI * 2 + rng() * 0.3;
    const radius = 28 + Math.round(rng() * 14);
    const start = offsetLatLng(origin.latitude, origin.longitude, radius * Math.cos(angle), radius * Math.sin(angle));
    return {
      id: `DEV-${idx + 1}`,
      color: simPalette[idx % simPalette.length],
      selected: idx === 0,
      lat: start.lat,
      lng: start.lng,
      targetIndex: idx % targets.length,
      queue: 0,
      enters: 0,
      cooldownHits: 0,
      apiOk: 0,
      apiFail: 0,
      avgMs: 0,
      currentPoiId: null,
      currentPoiName: '—',
      destinationName: targets[idx % targets.length]?.name || '—',
      lastEnterAt: null,
      lastCooldownPlaceId: null,
      holdTicks: 0,
      cycleHits: 0,
      deterministicHits: 0,
    };
  });
  simState.totalEnters = 0;
  simState.test.metrics.uniqueDeviceIds = 0;
  renderSimUI();
  renderSimMap();
  addSimLog(`initialized ${simState.devices.length} device(s) with ${targets.length} target(s)`, 'meta');
}

function getSimDevice(deviceId = simState.selectedDeviceId) {
  return simState.devices.find(d => d.id === deviceId) || simState.devices[0] || null;
}

function selectSimDevice(deviceId) {
  simState.selectedDeviceId = deviceId;
  simState.devices.forEach(d => d.selected = d.id === deviceId);
  const label = document.getElementById('sim-selected-label');
  if (label) label.textContent = deviceId;
  renderSimMap();
  renderSimUI();
}

function renderSimUI() {
  const table = document.getElementById('sim-device-table');
  if (!table) return;
  document.getElementById('sim-device-count').textContent = String(simState.devices.length);
  document.getElementById('sim-enter-count').textContent = String(simState.totalEnters);
  document.getElementById('sim-log-badge').classList.toggle('hidden', !simState.running);
  renderScenarioSelect();
  renderScenarioBadge();
  renderSimSummary();
  renderSimTargetSelect();

  table.innerHTML = simState.devices.map(d => {
    const cooldownMs = getScenarioCooldownMs();
    const cooldown = d.lastEnterAt ? `${Math.max(0, Math.ceil((cooldownMs - (Date.now() - d.lastEnterAt)) / 1000))}s` : '0s';
    const rowClass = d.id === simState.selectedDeviceId ? 'sim-device-row active' : 'sim-device-row';
    return `
      <tr class="${rowClass}" onclick="selectSimDevice('${d.id}')">
        <td class="px-3 py-3 font-bold">
          <span class="inline-flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full" style="background:${d.color}"></span>
            ${d.id}
          </span>
        </td>
        <td class="px-3 py-3">${d.queue}</td>
        <td class="px-3 py-3">${d.enters}</td>
        <td class="px-3 py-3">${cooldown}</td>
        <td class="px-3 py-3 text-emerald-300">${d.apiOk}</td>
        <td class="px-3 py-3 text-rose-300">${d.apiFail}</td>
        <td class="px-3 py-3">${d.avgMs ? Math.round(d.avgMs) : '—'}</td>
        <td class="px-3 py-3">${escapeHtml(d.currentPoiName || '—')}</td>
        <td class="px-3 py-3">${escapeHtml(d.destinationName || '—')}</td>
      </tr>`;
  }).join('');
}

function renderSimTargetSelect() {
  const select = document.getElementById('sim-target-select');
  if (!select) return;

  const targets = getSimTargets();
  const device = getSimDevice();
  const currentValue = device ? String(currentSimTarget(device)?.placeId ?? '') : '';

  select.innerHTML = targets.map(t => {
    const selected = String(t.placeId) === currentValue ? 'selected' : '';
    return `<option value="${t.placeId}" ${selected}>${escapeHtml(t.name)}</option>`;
  }).join('');

  if (device && currentValue && select.value !== currentValue) {
    select.value = currentValue;
  }
}

function clearSimMapLayers() {
  simState.markers.forEach(m => map.removeLayer(m));
  simState.circles.forEach(c => map.removeLayer(c));
  simState.routes.forEach(r => map.removeLayer(r));
  simState.markers = [];
  simState.circles = [];
  simState.routes = [];
}

function renderSimMap() {
  if (!simState.devices.length) return;
  clearSimMapLayers();

  simState.devices.forEach(device => {
    const marker = L.marker([device.lat, device.lng], {
      icon: makeSimDeviceIcon(device.color, device.id, device.selected)
    }).addTo(map);
    marker.on('click', () => selectSimDevice(device.id));
    simState.markers.push(marker);
  });

  const targets = getSimTargets();
  targets.forEach(target => {
    const radius = Number(target.radius || 50);
    const circle = L.circle([target.latitude, target.longitude], {
      radius,
      color: '#e94560',
      weight: 1.5,
      fillColor: '#e94560',
      fillOpacity: 0.06,
      dashArray: '5,6'
    }).addTo(map);
    simState.circles.push(circle);
  });
}

function currentSimTarget(device) {
  const targets = getSimTargets();
  if (!targets.length) return null;
  return targets[device.targetIndex % targets.length];
}

function advanceSimTarget(device) {
  const targets = getSimTargets();
  if (!targets.length) return null;
  device.targetIndex = (device.targetIndex + 1) % targets.length;
  return currentSimTarget(device);
}

function applyScenarioPreset(scenario) {
  const cluster = document.getElementById('sim-cluster');
  const step = document.getElementById('sim-step');
  const interval = document.getElementById('sim-interval');
  const select = document.getElementById('sim-scenario-select');
  if (cluster) cluster.value = scenario.cluster || 'top4';
  if (step && scenario.step != null) step.value = scenario.step;
  if (interval && scenario.interval != null) interval.value = scenario.interval;
  if (select) select.value = scenario.id;
  renderSimTargetSelect();
}

function resetScenarioStats() {
  simState.events = [];
  simState.test = {
    scenarioId: null,
    name: null,
    status: 'IDLE',
    startedAt: null,
    endedAt: null,
    seed: null,
    checks: [],
    resultText: 'NO RUN',
    score: 0,
    metrics: {
      apiOk: 0,
      apiFail: 0,
      cooldownHits: 0,
      targetChanges: 0,
      manualMoves: 0,
      uniqueDeviceIds: 0,
      avgLatencyMs: 0,
      totalEvents: 0,
      cycleHits: 0,
      deterministicHits: 0
    }
  };
  renderScenarioBadge();
  renderSimSummary();
}

function startScenarioMetrics(scenario) {
  const seed = normalizeSeed(getScenarioSeedValue(scenario));
  simState.seed = seed;
  simState.rng = createSeededRng(seed);
  simState.test.scenarioId = scenario.id;
  simState.test.name = scenario.name;
  simState.test.status = 'RUNNING';
  simState.test.startedAt = Date.now();
  simState.test.endedAt = null;
  simState.test.seed = seed;
  simState.test.checks = [];
  simState.test.resultText = 'RUNNING';
  simState.test.metrics = {
    apiOk: 0,
    apiFail: 0,
    cooldownHits: 0,
    targetChanges: 0,
    manualMoves: 0,
    uniqueDeviceIds: 0,
    avgLatencyMs: 0,
    totalEvents: 0,
    cycleHits: 0,
    deterministicHits: 0
  };
  simState.activeScenario = scenario;
  setScenarioSeedValue(seed);
  renderScenarioBadge();
  renderSimSummary();
  addSimLog(`seed locked: ${seed}`, 'meta');
}

function updateScenarioMetricsFromState() {
  const test = simState.test;
  const enterEvents = simState.events.filter(e => e.type === 'enter');
  const uniqueDevices = new Set(enterEvents.map(e => e.deviceId).filter(Boolean));
  const latencies = simState.events.filter(e => e.type === 'api').map(e => e.latency).filter(n => typeof n === 'number');
  test.metrics.apiOk = simState.devices.reduce((sum, d) => sum + (d.apiOk || 0), 0);
  test.metrics.apiFail = simState.devices.reduce((sum, d) => sum + (d.apiFail || 0), 0);
  test.metrics.cooldownHits = simState.devices.reduce((sum, d) => sum + (d.cooldownHits || 0), 0);
  test.metrics.targetChanges = simState.events.filter(e => e.type === 'target-change').length;
  test.metrics.manualMoves = simState.events.filter(e => e.type === 'manual-move').length;
  test.metrics.uniqueDeviceIds = uniqueDevices.size;
  test.metrics.avgLatencyMs = latencies.length ? latencies.reduce((a, b) => a + b, 0) / latencies.length : 0;
  test.metrics.totalEvents = simState.events.length;
  test.metrics.cycleHits = simState.events.filter(e => e.type === 'cycle-hit').length;
  test.metrics.deterministicHits = simState.events.filter(e => e.type === 'deterministic-hit').length;
}

function finishScenarioTest(reason = 'done') {
  if (!simState.activeScenario) return;
  if (simState.scenarioTimer) {
    clearTimeout(simState.scenarioTimer);
    simState.scenarioTimer = null;
  }
  stopSimTimer();
  updateScenarioMetricsFromState();
  const scenario = simState.activeScenario;
  const checks = typeof scenario.evaluate === 'function' ? scenario.evaluate(simState) : [];
  simState.test.checks = checks;
  simState.test.endedAt = Date.now();
  simState.test.status = checks.every(c => c.pass) ? 'PASS' : 'FAIL';
  simState.test.score = calculateScenarioScore(checks);
  simState.test.resultText = `${simState.test.status} | ${scoreLabelFromPercent(simState.test.score)}${reason ? ` (${reason})` : ''}`;
  simState.activeScenario = null;
  addSimLog(`scenario ${simState.test.resultText}`, simState.test.status === 'PASS' ? 'success' : 'error');
  renderScenarioBadge();
  renderSimSummary();
}

function runSelectedScenario() {
  const scenario = getScenario(document.getElementById('sim-scenario-select')?.value);
  stopScenarioTest(false);
  resetSimState();
  applyScenarioPreset(scenario);
  simState.activeScenario = scenario;
  startScenarioMetrics(scenario);
  initSimState();
  if (!simState.devices.length) return;

  // scenario-specific initial position setup
  scenario.setup?.(simState);
  simState.devices.forEach((device, index) => {
    if (scenario.deviceCount === 1 && index > 0) return;
    if (scenario.convergeFirst) {
      const master = getSimTargets()[0];
      if (master) {
        const pos = offsetLatLng(master.latitude, master.longitude, 18 + index * 8, index % 2 === 0 ? 18 : -18);
        device.lat = pos.lat;
        device.lng = pos.lng;
        device.targetIndex = 0;
      }
    }
  });

  addSimLog(`scenario start: ${scenario.name}`, 'meta');
  if (scenario.requiresManualTargetChange) {
    addSimLog('manual step: change target from dropdown, then start walk', 'meta');
  }
  trackSimEvent('scenario-start', { scenarioId: scenario.id, name: scenario.name });
  renderSimMap();
  renderSimUI();

  if (scenario.autoStartWalk) startSimTimer();

  simState.scenarioTimer = setTimeout(() => finishScenarioTest('timeout'), scenario.durationMs || 15000);
}

function replaySelectedScenario() {
  const scenario = getScenario(document.getElementById('sim-scenario-select')?.value);
  const seed = normalizeSeed(simState.test.seed ?? scenario.seed ?? getScenarioSeedValue(scenario));
  setScenarioSeedValue(seed);
  runSelectedScenario();
}

function stopScenarioTest(manual = true) {
  if (simState.scenarioTimer) {
    clearTimeout(simState.scenarioTimer);
    simState.scenarioTimer = null;
  }
  if (simState.activeScenario) {
    updateScenarioMetricsFromState();
    const scenario = simState.activeScenario;
    const checks = typeof scenario.evaluate === 'function' ? scenario.evaluate(simState) : [];
    simState.test.checks = checks;
    simState.test.endedAt = Date.now();
    simState.test.status = checks.every(c => c.pass) ? 'PASS' : 'FAIL';
    simState.test.score = calculateScenarioScore(checks);
    simState.test.resultText = `${simState.test.status} | ${scoreLabelFromPercent(simState.test.score)}${manual ? ' (manual stop)' : ''}`;
    simState.activeScenario = null;
    addSimLog(`scenario stop: ${simState.test.resultText}`, simState.test.status === 'PASS' ? 'success' : 'error');
    renderScenarioBadge();
    renderSimSummary();
  }
}

function exportSimSessionJson() {
  updateScenarioMetricsFromState();
  const scenario = simState.activeScenario || getScenario(simState.test.scenarioId);
  const payload = {
    exportedAt: new Date().toISOString(),
    seed: simState.test.seed,
    scenario: simState.test.name,
    scenarioConfig: scenario ? {
      id: scenario.id,
      name: scenario.name,
      cluster: scenario.cluster,
      step: scenario.step,
      interval: scenario.interval,
      durationMs: scenario.durationMs,
      cooldownMinutes: scenario.cooldownMinutes ?? 30,
      holdTarget: !!scenario.holdTarget,
      autoStartWalk: !!scenario.autoStartWalk
    } : null,
    test: simState.test,
    devices: simState.devices.map(d => ({
      id: d.id,
      lat: d.lat,
      lng: d.lng,
      enters: d.enters,
      cooldownHits: d.cooldownHits,
      apiOk: d.apiOk,
      apiFail: d.apiFail,
      avgMs: d.avgMs,
      currentPoiName: d.currentPoiName,
      destinationName: d.destinationName,
      cycleHits: d.cycleHits || 0,
      deterministicHits: d.deterministicHits || 0
    })),
    events: simState.events,
    logs: simState.log
  };

  const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `geofence-sim-${new Date().toISOString().replace(/[:.]/g, '-')}.json`;
  a.click();
  setTimeout(() => URL.revokeObjectURL(url), 300);
}

function setSelectedDeviceTarget(placeIdText) {
  const device = getSimDevice();
  if (!device) return;
  const placeId = Number(placeIdText);
  const targets = getSimTargets();
  const index = targets.findIndex(t => t.placeId === placeId);
  if (index < 0) return;
  device.targetIndex = index;
  device.destinationName = targets[index].name;
  trackSimEvent('target-change', { deviceId: device.id, placeId, placeName: targets[index].name });
  simState.test.metrics.targetChanges += 1;
  addSimLog(`${device.id} target -> ${targets[index].name}`, 'meta');
  renderSimMap();
  renderSimUI();
}

function setSimDestination(device, target) {
  device.destinationName = target ? target.name : '—';
  renderSimUI();
}

function distanceToTarget(device, target) {
  return target ? haversine(device.lat, device.lng, target.latitude, target.longitude) : Infinity;
}

function maybeTriggerEnter(device, place) {
  const radius = Number(place.radius || 50);
  const dist = haversine(device.lat, device.lng, place.latitude, place.longitude);
  const now = Date.now();
  const cooldownMinutes = Number(simState.activeScenario?.cooldownMinutes ?? place.cooldownMinutes ?? 30);
  const cooldownMs = Math.max(1000, cooldownMinutes * 60 * 1000);
  const cooldownActive = device.lastEnterAt && (now - device.lastEnterAt) < cooldownMs && device.lastCooldownPlaceId === place.placeId;
  const cooldownElapsed = device.lastEnterAt && (now - device.lastEnterAt) >= cooldownMs && device.lastCooldownPlaceId === place.placeId;

  if (dist > radius) {
    device.currentPoiId = null;
    device.currentPoiName = '—';
    return;
  }

  if (cooldownActive) {
    device.cooldownHits += 1;
    device.currentPoiId = place.placeId;
    device.currentPoiName = place.name;
    trackSimEvent('cooldown', { deviceId: device.id, placeId: place.placeId, placeName: place.name });
    return;
  }

  if (device.currentPoiId !== place.placeId || cooldownElapsed) {
    device.queue += 1;
    device.currentPoiId = place.placeId;
    device.currentPoiName = place.name;
    device.lastEnterAt = now;
    device.lastCooldownPlaceId = place.placeId;
    device.enters += 1;
    simState.totalEnters += 1;
    trackSimEvent('enter', { deviceId: device.id, placeId: place.placeId, placeName: place.name });
    trackSimEvent('deterministic-hit', { deviceId: device.id, placeId: place.placeId });
    device.deterministicHits += 1;
    setSimDestination(device, currentSimTarget(device));
    addSimLog(`${device.id} enter geofence: ${place.name}`, 'success');
    renderSimUI();

    const latency = 180 + Math.floor((simState.rng || Math.random)() * 620);
    setTimeout(() => {
      device.queue = Math.max(0, device.queue - 1);
      const ok = simState.activeScenario?.simulateApiFlakiness ? (simState.rng || Math.random)() > 0.12 : true;
      if (ok) {
        device.apiOk += 1;
        device.avgMs = device.avgMs ? (device.avgMs * 0.75 + latency * 0.25) : latency;
        trackSimEvent('api', { deviceId: device.id, placeId: place.placeId, placeName: place.name, latency, ok: true });
        addSimLog(`${device.id} API OK ${latency}ms -> ${place.name}`, 'success');
      } else {
        device.apiFail += 1;
        trackSimEvent('api', { deviceId: device.id, placeId: place.placeId, placeName: place.name, latency, ok: false });
        addSimLog(`${device.id} API FAIL -> ${place.name}`, 'error');
      }
      renderSimUI();
    }, latency);
  }
}

function tickSimWalk() {
  const targets = getSimTargets();
  if (!targets.length) return;

  const stepMeters = Math.max(1, Number(document.getElementById('sim-step')?.value || 18));
  simState.devices.forEach(device => {
    const target = currentSimTarget(device);
    if (!target) return;

    const dist = distanceToTarget(device, target);
    if (dist < Math.max(8, stepMeters * 0.9)) {
      device.lat = target.latitude;
      device.lng = target.longitude;
      maybeTriggerEnter(device, target);
      if (!simState.activeScenario?.holdTarget) {
        advanceSimTarget(device);
      }
      setSimDestination(device, currentSimTarget(device));
      return;
    }

    const ratio = Math.min(1, stepMeters / Math.max(dist, 1));
    device.lat = device.lat + (target.latitude - device.lat) * ratio;
    device.lng = device.lng + (target.longitude - device.lng) * ratio;
    device.destinationName = target.name;

    const near = targets
      .slice()
      .sort((a, b) => haversine(device.lat, device.lng, a.latitude, a.longitude) - haversine(device.lat, device.lng, b.latitude, b.longitude))[0];
    if (near) maybeTriggerEnter(device, near);
    if (near && near.placeId === target.placeId) {
      device.cycleHits = (device.cycleHits || 0) + 1;
      trackSimEvent('cycle-hit', { deviceId: device.id, placeId: target.placeId, placeName: target.name });
    }
  });

  renderSimMap();
  renderSimUI();
}

function startSimTimer() {
  stopSimTimer();
  simState.running = true;
  document.getElementById('sim-toggle-btn').textContent = 'Stop Walk';
  document.getElementById('sim-log-badge').classList.remove('hidden');
  trackSimEvent('walk-start');
  addSimLog('auto-walk ON', 'meta');
  const interval = Math.max(100, Number(document.getElementById('sim-interval')?.value || 400));
  simState.timer = setInterval(tickSimWalk, interval);
  renderSimUI();
}

function stopSimTimer() {
  if (simState.timer) {
    clearInterval(simState.timer);
    simState.timer = null;
  }
  if (simState.running) {
    trackSimEvent('walk-stop');
    addSimLog('auto-walk OFF', 'meta');
  }
  simState.running = false;
  const btn = document.getElementById('sim-toggle-btn');
  if (btn) btn.textContent = 'Start Walk';
  renderSimUI();
}

function toggleSimWalk() {
  if (simState.running) stopSimTimer();
  else startSimTimer();
}

function convergeSimDevices() {
  const targets = getSimTargets();
  if (!targets.length) return;
  const master = targets[0];
  simState.devices.forEach((device, index) => {
    const rng = simState.rng || Math.random;
    const spread = 14 + Math.round(rng() * 10) + (index * 8);
    const pos = offsetLatLng(master.latitude, master.longitude, spread, spread * (index % 2 === 0 ? 1 : -1));
    device.lat = pos.lat;
    device.lng = pos.lng;
    device.targetIndex = 0;
    device.destinationName = master.name;
  });
  trackSimEvent('converge', { targetPlaceId: master.placeId, placeName: master.name });
  addSimLog(`converge all devices to ${master.name}`, 'meta');
  renderSimMap();
  renderSimUI();
}

function moveDeviceByMeters(device, northMeters, eastMeters) {
  const pos = offsetLatLng(device.lat, device.lng, northMeters, eastMeters);
  device.lat = pos.lat;
  device.lng = pos.lng;
}

function nudgeSelectedDevice(dx, dy) {
  const device = getSimDevice();
  if (!device) return;
  const meters = 12;
  moveDeviceByMeters(device, dy * meters, dx * meters);
  const target = currentSimTarget(device);
  if (target) maybeTriggerEnter(device, target);
  trackSimEvent('manual-move', { deviceId: device.id, dx, dy });
  simState.test.metrics.manualMoves += 1;
  addSimLog(`${device.id} manual move dx=${dx}, dy=${dy}`, 'meta');
  renderSimMap();
  renderSimUI();
}

function clearSimLog() {
  simState.log = [];
  localStorage.removeItem(simState.logKey);
  renderSimLog();
}

function saveSimLog() {
  localStorage.setItem(simState.logKey, JSON.stringify(simState.log));
  toast('Da luu simulator log', 'success');
}

function downloadSimLog() {
  const text = simState.log.map(x => `${x.at} | [SIM] ${x.message}`).join('\n') || '[SIM] empty log';
  const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `geofence-sim-${new Date().toISOString().replace(/[:.]/g, '-')}.log`;
  a.click();
  setTimeout(() => URL.revokeObjectURL(url), 300);
}

function toggleSimLogViewer() {
  const text = simState.log.map(x => `${x.at} | [SIM] ${x.message}`).join('\n') || '[SIM] empty log';
  const w = window.open('', '_blank', 'noopener,noreferrer,width=980,height=720');
  if (!w) {
    toast('Trinh duyet dang chan pop-up', 'error');
    return;
  }
  w.document.write(`<pre style="white-space:pre-wrap;font:12px/1.6 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;padding:24px;background:#0a0f0c;color:#8bf5a5;margin:0">${escapeHtml(text)}</pre>`);
  w.document.title = 'Geofence simulator log';
  w.document.close();
}

function resetSimState() {
  stopSimTimer();
  clearSimMapLayers();
  if (simState.scenarioTimer) {
    clearTimeout(simState.scenarioTimer);
    simState.scenarioTimer = null;
  }
  simState.activeScenario = null;
  simState.seed = null;
  simState.rng = Math.random;
  resetScenarioStats();
  initSimState();
  addSimLog('simulator reset', 'meta');
}

function syncSimMapLabels() {
  const selected = getSimDevice();
  if (selected) document.getElementById('sim-selected-label').textContent = selected.id;
}

const markers = {};
const bounds  = [];
const tempM   = { ref: null };

places.forEach(p => {
  if (!p.latitude||!p.longitude) return;
  const m = L.marker([p.latitude,p.longitude], { icon:makeIcon(colorFor(p)) }).addTo(map);
  m.bindPopup(buildPopup(p), { maxWidth:270 });
  m.on('click', () => hlItem(p.placeId));
  markers[p.placeId] = m;
  bounds.push([p.latitude,p.longitude]);
});
if (bounds.length) map.fitBounds(bounds, { padding:[40,40], maxZoom:15 });
loadSimLog();
if (simEnabled) {
  initSimState();
  renderScenarioSelect();
  renderScenarioBadge();
  renderSimSummary();
  setInterval(() => {
    if (simState.devices.length) renderSimUI();
  }, 1000);
}

function focusPlace(id) {
  const m = markers[id]; if (!m) return;
  map.setView(m.getLatLng(), 17, { animate:true });
  setTimeout(() => m.openPopup(), 300);
  hlItem(id);
}
function hlItem(id) {
  document.querySelectorAll('.place-item').forEach(el => el.style.background='');
  const el = document.querySelector(`[data-place-id="${id}"]`);
  if (el) { el.style.background='rgba(149,68,0,0.07)'; el.scrollIntoView({ block:'nearest' }); }
}

document.getElementById('place-search').addEventListener('input', function() {
  const q = this.value.toLowerCase();
  document.querySelectorAll('.place-item').forEach(el => { el.style.display = el.dataset.name?.includes(q)?'':'none'; });
});

// ── Add mode ──────────────────────────────────────────────────
let addMode = false;
function toggleAddMode() {
  addMode = !addMode;
  const btn    = document.getElementById('btn-add-mode');
  const notice = document.getElementById('add-notice');
  if (addMode) {
    document.getElementById('add-mode-icon').textContent = 'close';
    document.getElementById('add-mode-text').textContent = 'Hủy';
    btn.style.background='#475569'; notice.classList.remove('hidden');
    map.getContainer().style.cursor='crosshair';
  } else {
    document.getElementById('add-mode-icon').textContent = 'add_location';
    document.getElementById('add-mode-text').textContent = '+ Thêm quán';
    btn.style.background='linear-gradient(135deg,#954400,#fc8127)'; notice.classList.add('hidden');
    map.getContainer().style.cursor='';
    if (tempM.ref) { map.removeLayer(tempM.ref); tempM.ref=null; }
  }
}

map.on('click', e => {
  if (!addMode) return;
  const { lat, lng } = e.latlng;
  if (tempM.ref) map.removeLayer(tempM.ref);
  tempM.ref = L.marker([lat,lng], { icon:makeIcon('#954400',40), draggable:true }).addTo(map);
  tempM.ref.on('dragend', ev => {
    const p = ev.target.getLatLng();
    document.getElementById('edit-lat').value = p.lat.toFixed(6);
    document.getElementById('edit-lng').value = p.lng.toFixed(6);
    document.getElementById('location-text').textContent = `${p.lat.toFixed(5)}, ${p.lng.toFixed(5)}`;
    if (miniMap) { miniMap.setView([p.lat,p.lng]); miniMarker?.setLatLng([p.lat,p.lng]); }
  });
  document.getElementById('edit-lat').value = lat.toFixed(6);
  document.getElementById('edit-lng').value = lng.toFixed(6);
  document.getElementById('edit-place-id').value = '';
  document.getElementById('location-text').textContent = `${lat.toFixed(5)}, ${lng.toFixed(5)}`;
  ['f-name','f-phone','f-address','f-specialty','f-open','f-close','f-price','f-desc'].forEach(id => document.getElementById(id).value='');
  document.getElementById('panel-title').textContent    = 'Thêm quán mới';
  document.getElementById('panel-subtitle').textContent = 'Kéo pin để điều chỉnh vị trí';
  document.getElementById('btn-save-text').textContent  = 'Thêm quán';
  document.getElementById('delete-section').classList.add('hidden');
  openPanel();
  setTimeout(() => initMiniMap(lat, lng), 350);
});

function openEditPanel(placeId) {
  map.closePopup();
  const p = places.find(x => x.placeId===placeId); if (!p) return;
  document.getElementById('edit-place-id').value    = placeId;
  document.getElementById('edit-lat').value         = p.latitude;
  document.getElementById('edit-lng').value         = p.longitude;
  document.getElementById('f-name').value           = p.name??'';
  document.getElementById('f-phone').value          = p.phone??'';
  document.getElementById('f-address').value        = p.address??'';
  document.getElementById('f-specialty').value      = p.specialty??'';
  document.getElementById('f-open').value           = p.openTime??'';
  document.getElementById('f-close').value          = p.closeTime??'';
  document.getElementById('f-price').value          = p.pricePerPerson??'';
  document.getElementById('f-desc').value           = '';
  document.getElementById('location-text').textContent    = `${Number(p.latitude).toFixed(5)}, ${Number(p.longitude).toFixed(5)}`;
  document.getElementById('panel-title').textContent      = 'Chỉnh sửa quán';
  document.getElementById('panel-subtitle').textContent   = p.name;
  document.getElementById('btn-save-text').textContent    = 'Lưu thay đổi';
  document.getElementById('delete-section').classList.remove('hidden');
  document.getElementById('btn-delete').dataset.placeId   = placeId;
  document.getElementById('btn-delete').dataset.placeName = p.name;
  openPanel();
  setTimeout(() => initMiniMap(Number(p.latitude), Number(p.longitude)), 350);
}

function openPanel()  { document.getElementById('slide-panel').classList.remove('hidden-panel'); document.getElementById('panel-overlay').classList.remove('hidden'); }
function closePanel() { document.getElementById('slide-panel').classList.add('hidden-panel'); document.getElementById('panel-overlay').classList.add('hidden'); if (addMode) toggleAddMode(); }

async function savePlace() {
  const id   = document.getElementById('edit-place-id').value;
  const name = document.getElementById('f-name').value.trim();
  const addr = document.getElementById('f-address').value.trim();
  if (!name||!addr) { alert('Vui lòng nhập tên và địa chỉ!'); return; }
  const btn = document.getElementById('btn-save');
  btn.disabled=true; btn.innerHTML='Đang lưu...';
  const body = {
    name, phone: document.getElementById('f-phone').value||null, address:addr,
    latitude:   parseFloat(document.getElementById('edit-lat').value),
    longitude:  parseFloat(document.getElementById('edit-lng').value),
    specialty:  document.getElementById('f-specialty').value||null,
    openTime:   document.getElementById('f-open').value||null,
    closeTime:  document.getElementById('f-close').value||null,
    pricePerPerson: document.getElementById('f-price').value?parseInt(document.getElementById('f-price').value):null,
    description: document.getElementById('f-desc').value||null
  };
  try {
    const isEdit = !!id;
    const res = await fetch(`${API_BASE}/api/places${isEdit?'/'+id:''}`, {
      method: isEdit?'PUT':'POST',
      headers: { 'Content-Type':'application/json', 'Authorization':`Bearer ${jwt}` },
      body: JSON.stringify(body)
    });
    if (!res.ok) { const e=await res.json().catch(()=>({})); throw new Error(e.message||`HTTP ${res.status}`); }
    toast(isEdit?`Đã cập nhật «${name}»`:`Đã thêm «${name}» — chờ Admin duyệt`,'success');
    closePanel(); setTimeout(()=>location.reload(),1500);
  } catch(e) {
    toast('Lỗi: '+e.message,'error');
    btn.disabled=false; btn.innerHTML='<span class="material-symbols-outlined text-sm">save</span> <span id="btn-save-text">Lưu</span>';
  }
}

function deletePlace() {
  const btn=document.getElementById('btn-delete');
  confirmDeleteFromPopup(btn.dataset.placeId, btn.dataset.placeName);
}
function confirmDeleteFromPopup(id,name) {
  map.closePopup();
  document.getElementById('delete-confirm-name').textContent=`«${name}»`;
  document.getElementById('delete-modal').classList.remove('hidden');
  document.getElementById('btn-confirm-delete').onclick = async () => {
    document.getElementById('delete-modal').classList.add('hidden');
    try {
      const res=await fetch(`${API_BASE}/api/places/${id}`,{ method:'DELETE', headers:{'Authorization':`Bearer ${jwt}`} });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      toast(`Đã xóa «${name}»`,'info');
      closePanel(); setTimeout(()=>location.reload(),1500);
    } catch(e) { toast('Lỗi: '+e.message,'error'); }
  };
}

function toast(msg,type) {
  const cfg={success:'bg-emerald-50 border-emerald-100 text-emerald-700',error:'bg-red-50 border-red-100 text-red-700',info:'bg-blue-50 border-blue-100 text-blue-700'};
  const el=document.createElement('div');
  el.className=`flex items-center gap-3 px-4 py-3 rounded-xl border text-sm font-semibold shadow-lg min-w-[260px] ${cfg[type]||cfg.success}`;
  el.textContent=msg;
  let c=document.getElementById('toast-container');
  if(!c){c=document.createElement('div');c.id='toast-container';c.className='fixed bottom-6 right-6 z-[9999] flex flex-col gap-3';document.body.appendChild(c);}
  c.appendChild(el); setTimeout(()=>el.remove(),4000);
}

// ── Load Test Functions ──────────────────────────────────────────────────
async function runLoadTest() {
  const scenario = document.getElementById('test-scenario').value;
  const baseUrl = document.getElementById('test-base-url').value || 'http://localhost:5010';
  const btn = document.getElementById('test-btn-text').parentElement;
  const outputContainer = document.getElementById('test-output-container');
  const output = document.getElementById('test-output');
  const status = document.getElementById('test-status');
  
  btn.disabled = true;
  status.classList.remove('hidden');
  outputContainer.classList.remove('hidden');
  output.innerHTML = '';
  
  try {
    const response = await fetch(`/LoadTest/Run?file=${encodeURIComponent(scenario)}&baseUrl=${encodeURIComponent(baseUrl)}`);
    
    if (!response.ok) {
      throw new Error(`HTTP ${response.status}`);
    }
    
    const reader = response.body.getReader();
    const decoder = new TextDecoder();
    let buffer = '';
    
    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      
      buffer += decoder.decode(value, { stream: true });
      const lines = buffer.split('\n');
      buffer = lines.pop() || '';
      
      for (const line of lines) {
        if (line.startsWith('data: ')) {
          const data = line.substring(6);
          addTestOutput(data, output);
        }
      }
    }
    
    status.classList.add('hidden');
    toast('Test hoàn thành!', 'success');
  } catch (e) {
    addTestOutput(`[ERROR] ${e.message}`, output, 'error');
    status.classList.add('hidden');
    toast('Lỗi test: ' + e.message, 'error');
  } finally {
    btn.disabled = false;
  }
}

function addTestOutput(line, container, type = '') {
  const div = document.createElement('div');
  div.className = `test-output-line ${type === 'error' ? 'test-output-error' : type === 'success' ? 'test-output-success' : ''}`;
  div.textContent = line;
  container.appendChild(div);
  container.scrollTop = container.scrollHeight;
}

function clearTestOutput() {
  document.getElementById('test-output').innerHTML = '';
  document.getElementById('test-output-container').classList.add('hidden');
}
</script>
}

