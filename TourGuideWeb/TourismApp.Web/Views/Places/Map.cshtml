@using TourismApp.Web.Models
@model List<TourismApp.Web.Models.PlaceViewModel>
@{
  ViewData["Title"] = "Bản đồ quán ăn";
  var isAdmin = (bool)(ViewBag.IsAdmin ?? false);
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
  #map { height: 600px; width: 100%; }
  .leaflet-popup-content { margin: 0 !important; padding: 0 !important; }
  .leaflet-popup-content-wrapper { padding: 0 !important; border-radius: 14px !important; overflow: hidden; box-shadow: 0 8px 32px rgba(0,0,0,0.18) !important; }
  .slide-panel { transition: transform 0.3s cubic-bezier(.4,0,.2,1), opacity 0.3s; }
  .slide-panel.hidden-panel { transform: translateX(100%); opacity: 0; pointer-events: none; }
  .leaflet-control-locate { background: white; border-radius: 8px !important; box-shadow: 0 2px 8px rgba(0,0,0,0.15) !important; }
  .locating-pulse { animation: locPulse 1.2s infinite; }
  @@keyframes locPulse { 0%,100%{opacity:1} 50%{opacity:0.4} }
  .user-dot { width:18px; height:18px; background:#3b82f6; border:3px solid white; border-radius:50%; box-shadow:0 0 0 4px rgba(59,130,246,0.3); }
  .user-dot-outer { width:60px; height:60px; background:rgba(59,130,246,0.15); border:2px solid rgba(59,130,246,0.4); border-radius:50%; display:flex;align-items:center;justify-content:center; animation:ripple 2s infinite; }
  @@keyframes ripple { 0%{box-shadow:0 0 0 0 rgba(59,130,246,0.3)} 70%{box-shadow:0 0 0 20px rgba(59,130,246,0)} 100%{box-shadow:0 0 0 0 rgba(59,130,246,0)} }
  
  @@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  .animate-spin { animation: spin 1s linear infinite; }
  .sim-panel {
    border: 1px solid rgba(200, 169, 110, 0.18);
    background:
      radial-gradient(circle at top right, rgba(233, 69, 96, 0.12), transparent 28%),
      linear-gradient(180deg, #1a1410 0%, #120e0b 100%);
    color: #f0e6d3;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.32);
  }
  .sim-panel .panel-surface {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .sim-panel .panel-label {
    color: #c8a96e;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }
  .sim-terminal {
    background: #0a0f0c;
    border: 1px solid rgba(76, 175, 80, 0.18);
    color: #8bf5a5;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
  }
  .sim-terminal-line {
    padding: 0.125rem 0;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .sim-device-row {
    cursor: pointer;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }
  .sim-device-row:hover {
    background: rgba(255, 255, 255, 0.03);
  }
  .sim-device-row.active {
    background: rgba(200, 169, 110, 0.1);
    outline: 1px solid rgba(200, 169, 110, 0.18);
  }
  .sim-mini-btn {
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    color: #f0e6d3;
    transition: all 0.15s ease;
  }
  .sim-mini-btn:hover {
    background: rgba(200, 169, 110, 0.14);
    border-color: rgba(200, 169, 110, 0.28);
  }
  .sim-mini-btn.primary {
    background: linear-gradient(135deg, #954400, #fc8127);
    color: white;
    border-color: transparent;
  }
  .sim-mini-btn.primary:hover {
    filter: brightness(1.05);
  }
  .sim-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }
  .runner-dock {
    position: fixed;
    top: 88px;
    right: 18px;
    width: min(460px, calc(100vw - 24px));
    max-height: calc(100vh - 110px);
    z-index: 4100;
    overflow: hidden;
    border-radius: 24px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.38);
    backdrop-filter: blur(18px);
  }
  .runner-dock .runner-body {
    max-height: calc(100vh - 170px);
    overflow: auto;
  }
  .sim-score-ring {
    background:
      radial-gradient(circle at center, rgba(200, 169, 110, 0.22) 0%, rgba(200, 169, 110, 0.08) 42%, transparent 43%),
      rgba(255, 255, 255, 0.03);
  }
</style>

<div class="flex items-center justify-between mb-5 pt-2">
  <div>
    <h2 class="text-3xl font-extrabold tracking-tight">@(isAdmin ? "🗺️ Bản đồ toàn hệ thống" : "🗺️ Bản đồ quán của tôi")</h2>
    <p class="text-sm text-on-surface-variant mt-1">
      @Model.Count quán &bull; @Model.Count(p => p.OpenStatus == "Open") đang mở
      @if (!isAdmin) { <span> &bull; <span class="text-primary font-semibold">Click bản đồ để thêm quán mới</span></span> }
    </p>
  </div>
  <div class="flex items-center gap-2">
    <!-- Locate me button -->
    <button id="btn-locate" onclick="locateMe()"
            class="flex items-center gap-2 px-4 py-2.5 bg-blue-50 text-blue-700 font-bold rounded-xl text-sm hover:bg-blue-100 transition-all"
            title="Định vị vị trí của tôi">
      <span class="material-symbols-outlined text-sm" id="locate-icon">my_location</span>
      <span id="locate-text" class="hidden sm:inline">Vị trí của tôi</span>
    </button>
    @if (!isAdmin)
    {
      <button id="btn-add-mode" onclick="toggleAddMode()"
              class="flex items-center gap-2 px-5 py-2.5 text-white font-bold rounded-xl text-sm transition-all"
              style="background:linear-gradient(135deg,#954400,#fc8127)">
        <span class="material-symbols-outlined text-sm" id="add-mode-icon">add_location</span>
        <span id="add-mode-text">+ Thêm quán</span>
      </button>
    }
    <div class="hidden md:flex items-center gap-3 bg-surface-container-lowest px-4 py-2.5 rounded-xl shadow-sm text-xs font-bold">
      <span class="flex items-center gap-1.5 text-emerald-600"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>Mở</span>
      <span class="flex items-center gap-1.5 text-amber-600"><span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>Bận</span>
      <span class="flex items-center gap-1.5 text-slate-500"><span class="w-2.5 h-2.5 rounded-full bg-slate-400"></span>Đóng</span>
      <span class="flex items-center gap-1.5 text-blue-600"><span class="w-2.5 h-2.5 rounded-full bg-blue-400"></span>Bạn</span>
      @if (isAdmin) {
        <span class="flex items-center gap-1.5 text-amber-700"><span class="w-2.5 h-2.5 rounded-full bg-amber-300 border border-amber-500"></span>Chờ duyệt</span>
      }
    </div>
  </div>
</div>

<div id="add-notice" class="hidden mb-3 flex items-center gap-3 p-4 bg-primary/10 border border-primary/20 rounded-xl">
  <span class="material-symbols-outlined text-primary">touch_app</span>
  <p class="text-sm font-semibold text-primary flex-1">Đang ở chế độ thêm quán — Click vào vị trí trên bản đồ để đặt pin</p>
  <button onclick="toggleAddMode()" class="text-primary font-bold text-sm">Hủy</button>
</div>

<!-- Locate status bar -->
<div id="locate-status" class="hidden mb-3 flex items-center gap-3 p-3 bg-blue-50 border border-blue-100 rounded-xl text-sm text-blue-700 font-semibold">
  <span class="material-symbols-outlined text-blue-500 locating-pulse" id="locate-status-icon">gps_fixed</span>
  <span id="locate-status-text">Đang định vị...</span>
  <button onclick="clearLocation()" class="ml-auto text-blue-400 hover:text-blue-600 text-xs font-bold">Xóa</button>
</div>

@if (isAdmin)
{
  <div id="sim-panel" class="sim-panel mb-4 rounded-3xl overflow-hidden">
    <div class="flex items-center justify-between border-b border-white/5 px-5 py-4">
      <div class="flex items-center gap-3">
        <span class="material-symbols-outlined text-[#c8a96e]">radar</span>
        <div>
          <h3 class="text-sm font-black uppercase tracking-[0.22em] text-[#f0e6d3]">Geofence Simulator</h3>
          <p class="text-xs text-[#8d7a66] mt-0.5">Auto walk, manual move, log runner va device stats ngay tren map</p>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="sim-chip bg-emerald-500/10 text-emerald-300"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>Client log</span>
        <span class="sim-chip bg-cyan-500/10 text-cyan-300"><span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>Automation test</span>
        <span class="sim-chip bg-rose-500/10 text-rose-300"><span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>Map overlay</span>
      </div>
    </div>

    <div class="grid gap-4 p-5 xl:grid-cols-[340px_1fr]">
      <div class="space-y-4">
        <div class="panel-surface rounded-2xl p-4">
          <div class="flex items-center justify-between mb-3">
            <div>
              <div class="panel-label">Auto Walk</div>
              <p class="text-xs text-[#9b8b75] mt-1">Buoc, chu ky va preset cluster</p>
            </div>
            <button id="sim-toggle-btn" onclick="toggleSimWalk()" class="sim-mini-btn primary rounded-xl px-4 py-2 text-xs font-bold">Start Walk</button>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <label class="space-y-1">
              <span class="text-[11px] font-bold text-[#c8a96e]">Buoc (m)</span>
              <input id="sim-step" type="number" min="1" value="18" class="w-full rounded-xl border border-white/10 bg-black/20 px-3 py-2 text-sm text-[#f0e6d3] outline-none focus:border-[#c8a96e]" />
            </label>
            <label class="space-y-1">
              <span class="text-[11px] font-bold text-[#c8a96e]">Interval (ms)</span>
              <input id="sim-interval" type="number" min="100" step="50" value="400" class="w-full rounded-xl border border-white/10 bg-black/20 px-3 py-2 text-sm text-[#f0e6d3] outline-none focus:border-[#c8a96e]" />
            </label>
          </div>

          <div class="mt-3 space-y-1">
            <label class="text-[11px] font-bold text-[#c8a96e]">Cluster preset</label>
            <select id="sim-cluster" class="w-full rounded-xl border border-white/10 bg-black/20 px-3 py-2 text-sm text-[#f0e6d3] outline-none focus:border-[#c8a96e]">
              <option value="top3">Top 3 places</option>
              <option value="top4" selected>Cluster 4</option>
              <option value="top5">Cluster 5</option>
              <option value="all">All active places</option>
            </select>
          </div>

          <div class="mt-4 flex flex-wrap gap-2">
            <button onclick="convergeSimDevices()" class="sim-mini-btn rounded-xl px-3 py-2 text-xs font-bold">Converge</button>
            <button onclick="stopSimWalk()" class="sim-mini-btn rounded-xl px-3 py-2 text-xs font-bold">Stop</button>
            <button onclick="resetSimState()" class="sim-mini-btn rounded-xl px-3 py-2 text-xs font-bold">Reset</button>
          </div>
        </div>

        <div class="panel-surface rounded-2xl p-4">
          <div class="flex items-center justify-between mb-3">
            <div>
              <div class="panel-label">Test Scenarios</div>
              <p class="text-xs text-[#9b8b75] mt-1">Chay bai test co PASS/FAIL, score, seed va replay</p>
            </div>
            <span id="sim-scenario-badge" class="sim-chip bg-white/5 text-[#f0e6d3]">IDLE</span>
          </div>
          <select id="sim-scenario-select" onchange="updateScenarioDescription(this.value)" class="w-full rounded-xl border border-white/10 bg-black/20 px-3 py-2 text-sm text-[#f0e6d3] outline-none focus:border-[#c8a96e]"></select>
          <p id="sim-scenario-desc" class="mt-2 text-[11px] leading-5 text-[#8d7a66]">Chon scenario de xem mo ta.</p>
          <div class="mt-3 grid grid-cols-[1fr_auto] gap-2">
            <label class="space-y-1">
              <span class="text-[11px] font-bold text-[#c8a96e]">Seed</span>
              <input id="sim-seed" type="number" min="1" step="1" value="101" class="w-full rounded-xl border border-white/10 bg-black/20 px-3 py-2 text-sm text-[#f0e6d3] outline-none focus:border-[#c8a96e]" />
            </label>
            <div class="flex items-end">
              <button onclick="replaySelectedScenario()" class="sim-mini-btn rounded-xl px-3 py-2 text-xs font-bold">Replay seed</button>
            </div>
          </div>
          <div class="mt-3 flex flex-wrap gap-2">
            <button onclick="runSelectedScenario()" class="sim-mini-btn primary rounded-xl px-3 py-2 text-xs font-bold">Run Scenario</button>
            <button onclick="stopScenarioTest(true)" class="sim-mini-btn rounded-xl px-3 py-2 text-xs font-bold">Stop</button>
            <button onclick="exportSimSessionJson()" class="sim-mini-btn rounded-xl px-3 py-2 text-xs font-bold">Export JSON</button>
          </div>
        </div>

        <div class="panel-surface rounded-2xl p-4">
          <div class="flex items-center justify-between mb-3">
            <div>
              <div class="panel-label">Manual</div>
              <p class="text-xs text-[#9b8b75] mt-1">Di chuyen thiet bi dang chon va doi dich den</p>
            </div>
            <span id="sim-selected-label" class="text-xs font-bold text-[#f0e6d3]">DEV-1</span>
          </div>
          <div class="space-y-2 mb-3">
            <label class="text-[11px] font-bold text-[#c8a96e]">Đích đến</label>
            <select id="sim-target-select" onchange="setSelectedDeviceTarget(this.value)" class="w-full rounded-xl border border-white/10 bg-black/20 px-3 py-2 text-sm text-[#f0e6d3] outline-none focus:border-[#c8a96e]"></select>
            <p class="text-[11px] text-[#8d7a66]">Chọn POI để device đang chọn sẽ đi tới. Nếu đổi cluster preset thì danh sách này sẽ cập nhật theo preset mới.</p>
          </div>
          <div class="grid grid-cols-3 gap-2">
            <div></div>
            <button onclick="nudgeSelectedDevice(0, 1)" class="sim-mini-btn rounded-xl py-3 text-sm font-bold">↑</button>
            <div></div>
            <button onclick="nudgeSelectedDevice(-1, 0)" class="sim-mini-btn rounded-xl py-3 text-sm font-bold">←</button>
            <button onclick="nudgeSelectedDevice(0, 0)" class="sim-mini-btn rounded-xl py-3 text-sm font-bold">•</button>
            <button onclick="nudgeSelectedDevice(1, 0)" class="sim-mini-btn rounded-xl py-3 text-sm font-bold">→</button>
            <div></div>
            <button onclick="nudgeSelectedDevice(0, -1)" class="sim-mini-btn rounded-xl py-3 text-sm font-bold">↓</button>
            <div></div>
          </div>
          <p class="mt-3 text-[11px] leading-5 text-[#8d7a66]">Mui ten dung de day device dang chon tren map. Nut giua giu vi tri va kiem tra geofence ngay.</p>
        </div>

        <div class="panel-surface rounded-2xl p-4">
          <div class="flex items-center justify-between mb-3">
            <div>
              <div class="panel-label">Log File</div>
              <p class="text-xs text-[#9b8b75] mt-1">Luu, tai xuong hoac xem log hien tai</p>
            </div>
            <button onclick="clearSimLog()" class="text-xs font-bold text-[#9b8b75] hover:text-white">Clear</button>
          </div>
          <div class="flex flex-wrap gap-2">
            <button onclick="saveSimLog()" class="sim-mini-btn rounded-xl px-3 py-2 text-xs font-bold">Save</button>
            <button onclick="downloadSimLog()" class="sim-mini-btn rounded-xl px-3 py-2 text-xs font-bold">Download</button>
            <button onclick="toggleSimLogViewer()" class="sim-mini-btn rounded-xl px-3 py-2 text-xs font-bold">View</button>
          </div>
          <p class="mt-3 text-[11px] leading-5 text-[#8d7a66]">Log duoc luu vao localStorage va co the xuat ra file .log de gan vao test report.</p>
        </div>
      </div>

      <div class="space-y-4">
        <div class="panel-surface rounded-2xl p-4">
          <div class="flex items-center justify-between mb-3">
            <div>
              <div class="panel-label">Device Stats</div>
              <p class="text-xs text-[#9b8b75] mt-1">Queue, enters, cooldown, API, latency va current POI</p>
            </div>
            <div class="flex items-center gap-2 text-xs font-bold text-[#8d7a66]">
              <span class="sim-chip bg-white/5 text-[#f0e6d3]"><span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span><span id="sim-device-count">3</span> devices</span>
              <span class="sim-chip bg-white/5 text-[#f0e6d3]"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span><span id="sim-enter-count">0</span> enters</span>
            </div>
          </div>
          <div class="overflow-x-auto">
            <table class="min-w-full text-left text-xs">
              <thead class="text-[#c8a96e]">
                <tr class="border-b border-white/10">
                  <th class="px-3 py-2 font-bold uppercase tracking-[0.18em]">Device</th>
                  <th class="px-3 py-2 font-bold uppercase tracking-[0.18em]">Queue</th>
                  <th class="px-3 py-2 font-bold uppercase tracking-[0.18em]">Enters</th>
                  <th class="px-3 py-2 font-bold uppercase tracking-[0.18em]">Cooldown</th>
                  <th class="px-3 py-2 font-bold uppercase tracking-[0.18em]">API✓</th>
                  <th class="px-3 py-2 font-bold uppercase tracking-[0.18em]">API×</th>
                  <th class="px-3 py-2 font-bold uppercase tracking-[0.18em]">Avg ms</th>
                  <th class="px-3 py-2 font-bold uppercase tracking-[0.18em]">POI hien tai</th>
                  <th class="px-3 py-2 font-bold uppercase tracking-[0.18em]">Dang den</th>
                </tr>
              </thead>
              <tbody id="sim-device-table" class="text-[#f0e6d3]"></tbody>
            </table>
          </div>
        </div>

        <div class="panel-surface rounded-2xl p-4">
          <div class="flex items-center justify-between mb-3">
            <div>
              <div class="panel-label">Client Log</div>
              <p class="text-xs text-[#9b8b75] mt-1">Geofence + narration queue</p>
            </div>
            <span id="sim-log-badge" class="hidden sim-chip bg-emerald-500/10 text-emerald-300">RUNNING</span>
          </div>
          <div id="sim-log" class="sim-terminal h-64 overflow-y-auto rounded-2xl px-4 py-3 text-xs leading-5"></div>
        </div>

        <div class="panel-surface rounded-2xl p-4">
          <div class="flex items-center justify-between mb-3">
            <div>
              <div class="panel-label">Summary</div>
              <p class="text-xs text-[#9b8b75] mt-1">Ket qua luan bai test, co rubric de cham diem</p>
            </div>
            <span id="sim-summary-badge" class="sim-chip bg-white/5 text-[#f0e6d3]">NO RUN</span>
          </div>
          <div id="sim-summary-scenario" class="mb-3 text-xs font-semibold text-[#f0e6d3]">Scenario: —</div>
          <div class="grid grid-cols-3 gap-2 text-xs">
            <div class="rounded-xl bg-black/20 px-3 py-2 sim-score-ring">
              <div class="text-[#8d7a66]">Score</div>
              <div id="sim-summary-score" class="mt-1 font-black text-[#f0e6d3] text-lg">—</div>
            </div>
            <div class="rounded-xl bg-black/20 px-3 py-2">
              <div class="text-[#8d7a66]">Duration</div>
              <div id="sim-summary-duration" class="mt-1 font-bold text-[#f0e6d3]">—</div>
            </div>
            <div class="rounded-xl bg-black/20 px-3 py-2">
              <div class="text-[#8d7a66]">Enters</div>
              <div id="sim-summary-enters" class="mt-1 font-bold text-[#f0e6d3]">—</div>
            </div>
            <div class="rounded-xl bg-black/20 px-3 py-2">
              <div class="text-[#8d7a66]">API</div>
              <div id="sim-summary-api" class="mt-1 font-bold text-[#f0e6d3]">—</div>
            </div>
            <div class="rounded-xl bg-black/20 px-3 py-2">
              <div class="text-[#8d7a66]">Avg ms</div>
              <div id="sim-summary-avg" class="mt-1 font-bold text-[#f0e6d3]">—</div>
            </div>
            <div class="rounded-xl bg-black/20 px-3 py-2">
              <div class="text-[#8d7a66]">Seed</div>
              <div id="sim-summary-seed" class="mt-1 font-bold text-[#f0e6d3]">—</div>
            </div>
          </div>
          <div class="mt-3 space-y-2">
            <div class="text-[11px] font-bold uppercase tracking-[0.18em] text-[#c8a96e]">Checks</div>
            <div id="sim-summary-checks" class="space-y-2 text-xs"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
}

<div class="relative grid grid-cols-1 lg:grid-cols-3 gap-5">
  <!-- Map -->
  <div class="lg:col-span-2 bg-surface-container-lowest rounded-2xl shadow-sm overflow-hidden relative">
    <div id="map"></div>
    <!-- Nearby counter badge -->
    <div id="nearby-badge" class="hidden absolute bottom-3 left-3 z-[1000] bg-white/95 backdrop-blur px-4 py-2 rounded-xl shadow-lg text-sm font-bold text-blue-700 flex items-center gap-2">
      <span class="material-symbols-outlined text-sm">place</span>
      <span id="nearby-text">0 quán trong 500m</span>
    </div>
  </div>

  <!-- Sidebar -->
  <div class="bg-surface-container-lowest rounded-2xl shadow-sm overflow-hidden flex flex-col">
    <div class="px-5 py-4 border-b border-surface-container">
      <div class="flex items-center justify-between mb-2">
        <h3 class="font-bold text-sm">Danh sách quán</h3>
        <!-- Sort by distance toggle -->
        <button id="btn-sort-dist" onclick="sortByDistance()" title="Sắp xếp theo khoảng cách"
                class="text-[10px] font-bold px-2.5 py-1 bg-surface-container-low rounded-lg text-on-surface-variant hover:bg-blue-50 hover:text-blue-700 transition-all hidden">
          📍 Gần nhất
        </button>
      </div>
      <div class="relative">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-sm">search</span>
        <input id="place-search" type="text" placeholder="Tìm quán..."
               class="w-full pl-9 pr-4 py-2 bg-surface-container-low border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/20" />
      </div>
    </div>
    <div id="place-list" class="flex-1 overflow-y-auto divide-y divide-surface-container" style="max-height:510px">
      @foreach (var p in Model.OrderBy(p => p.Name))
      {
        <div class="place-item px-5 py-3.5 hover:bg-surface-container-low transition-colors cursor-pointer"
             data-place-id="@p.PlaceId"
             data-name="@p.Name.ToLower()"
             data-lat="@p.Latitude.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)"
             data-lng="@p.Longitude.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)"
             onclick="focusPlace(@p.PlaceId)">
          <div class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full shrink-0 mt-0.5
                         @(p.OpenStatus=="Open"?"bg-emerald-500":p.OpenStatus=="Busy"?"bg-amber-500":"bg-slate-300")"></span>
            <div class="flex-1 min-w-0">
              <p class="font-bold text-sm truncate">@p.Name</p>
              <p class="text-[11px] text-on-surface-variant truncate">@p.Address</p>
              @if (isAdmin && !string.IsNullOrEmpty(p.OwnerName))
              {
                <p class="text-[10px] text-primary font-semibold">@("👤 " + p.OwnerName)</p>
              }
              <p class="dist-label text-[10px] text-blue-600 font-semibold hidden"></p>
            </div>
            <div class="text-right shrink-0">
              <p class="text-xs font-bold text-amber-600">@("⭐" + p.AverageRating.ToString("F1"))</p>
              @{
                var (sc,st) = p.Status switch {
                  "Active"    => ("text-emerald-600","✓"),
                  "Pending"   => ("text-amber-600","⏳"),
                  "Suspended" => ("text-red-500","🔒"),
                  _           => ("text-slate-400","—")
                };
              }
              <p class="text-[10px] font-bold @sc">@st</p>
            </div>
          </div>
        </div>
      }
    </div>
    <div class="px-5 py-3 border-t border-surface-container bg-surface-container-low">
      <div class="flex justify-between text-xs text-on-surface-variant font-semibold">
        <span>@Model.Count(p=>p.OpenStatus=="Open") đang mở</span>
        <span>@Model.Count(p=>p.Status=="Active") hoạt động</span>
        @if (isAdmin) { <span>@Model.Count(p=>p.Status=="Pending") chờ duyệt</span> }
      </div>
    </div>
  </div>
</div>

<!-- Slide Panel Add/Edit -->
<div id="slide-panel" class="slide-panel hidden-panel fixed right-0 top-0 h-full w-full md:w-[420px] bg-white z-[2000] shadow-2xl flex flex-col overflow-hidden">
  <div class="flex items-center justify-between px-6 py-5 border-b border-slate-100"
