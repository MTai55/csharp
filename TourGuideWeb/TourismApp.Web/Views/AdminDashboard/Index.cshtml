@model TourismApp.Web.Models.AdminStatsViewModel?
@{
		ViewData["Title"] = "Admin Dashboard";
		var stats = Model ?? new TourismApp.Web.Models.AdminStatsViewModel();
}

<div class="space-y-6">
	<div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
		<div>
			<h1 class="text-3xl font-black text-slate-900 tracking-tight">Admin Dashboard</h1>
			<p class="mt-1 text-sm text-slate-500">Thống kê hệ thống, automation test và log runner cho map.</p>
		</div>
		<div class="flex flex-wrap gap-2">
			<a asp-area="Admin" asp-controller="AdminDashboard" asp-action="Map"
				 class="inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-bold text-white shadow-sm transition-all hover:opacity-95"
				 style="background:linear-gradient(135deg,#954400,#fc8127)">
				<span class="material-symbols-outlined text-sm">map</span>
				Mở bản đồ
			</a>
			<a asp-controller="LoadTest" asp-action="Index" asp-area=""
				 class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 transition-all hover:border-orange-300 hover:text-orange-700">
				<span class="material-symbols-outlined text-sm">terminal</span>
				Trang Load Test
			</a>
		</div>
	</div>

	<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
		<div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
			<div class="flex items-center justify-between">
				<div>
					<p class="text-xs font-bold uppercase tracking-wider text-slate-400">Users</p>
					<p class="mt-2 text-3xl font-black text-slate-900">@stats.TotalUsers</p>
				</div>
				<div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-50 text-blue-600">
					<span class="material-symbols-outlined">people</span>
				</div>
			</div>
		</div>
		<div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
			<div class="flex items-center justify-between">
				<div>
					<p class="text-xs font-bold uppercase tracking-wider text-slate-400">Places</p>
					<p class="mt-2 text-3xl font-black text-slate-900">@stats.TotalPlaces</p>
				</div>
				<div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-50 text-orange-600">
					<span class="material-symbols-outlined">storefront</span>
				</div>
			</div>
		</div>
		<div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
			<div class="flex items-center justify-between">
				<div>
					<p class="text-xs font-bold uppercase tracking-wider text-slate-400">Pending</p>
					<p class="mt-2 text-3xl font-black text-slate-900">@stats.PendingPlaces</p>
				</div>
				<div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-50 text-amber-600">
					<span class="material-symbols-outlined">hourglass_top</span>
				</div>
			</div>
		</div>
		<div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
			<div class="flex items-center justify-between">
				<div>
					<p class="text-xs font-bold uppercase tracking-wider text-slate-400">Online</p>
					<p class="mt-2 text-3xl font-black text-slate-900">@stats.OnlineDevices</p>
				</div>
				<div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600">
					<span class="material-symbols-outlined">devices</span>
				</div>
			</div>
		</div>
	</div>

	<div class="grid gap-6 xl:grid-cols-[1.15fr_0.85fr]">
		<section class="rounded-3xl border border-slate-200 bg-white shadow-sm overflow-hidden">
			<div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
				<div>
					<h2 class="text-lg font-black text-slate-900">Automation Test Runner</h2>
					<p class="text-sm text-slate-500">Chạy k6 và stream log ngay trong admin.</p>
				</div>
				<span class="rounded-full bg-orange-50 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-orange-700">SSE log stream</span>
			</div>

			<div class="space-y-5 p-5">
				<div class="grid gap-3 md:grid-cols-3">
					<div>
						<label class="mb-2 block text-xs font-bold uppercase tracking-wider text-slate-400">Scenario</label>
						<select id="runner-scenario" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm focus:border-orange-400 focus:ring-orange-400">
							<option value="poi_concurrent.js">POI Concurrent</option>
							<option value="heartbeat_load.js">Heartbeat 100 Devices</option>
						</select>
					</div>
					<div>
						<label class="mb-2 block text-xs font-bold uppercase tracking-wider text-slate-400">Base URL</label>
						<input id="runner-base-url" type="text" value="http://localhost:5010"
									 class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-mono focus:border-orange-400 focus:ring-orange-400" />
					</div>
					<div class="flex items-end gap-2">
						<button id="runner-start-btn" onclick="startRunner()"
										class="inline-flex w-full items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-sm font-bold text-white shadow-sm transition-all hover:opacity-95"
										style="background:linear-gradient(135deg,#954400,#fc8127)">
							<span class="material-symbols-outlined text-sm" id="runner-btn-icon">play_arrow</span>
							<span id="runner-btn-text">Chạy test</span>
						</button>
					</div>
				</div>

				<div class="grid gap-3 md:grid-cols-3">
					<div class="rounded-2xl bg-slate-50 p-3">
						<p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Tổng reviews</p>
						<p class="mt-1 text-2xl font-black text-slate-900">@stats.TotalReviews</p>
					</div>
					<div class="rounded-2xl bg-slate-50 p-3">
						<p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Avg rating</p>
						<p class="mt-1 text-2xl font-black text-slate-900">@stats.AvgRating.ToString("F1")</p>
					</div>
					<div class="rounded-2xl bg-slate-50 p-3">
						<p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Mode</p>
						<p class="mt-1 text-2xl font-black text-slate-900">Map + Runner</p>
					</div>
				</div>

				<div class="rounded-2xl border border-slate-200 bg-[#0d1117]">
					<div class="flex items-center justify-between border-b border-white/10 px-4 py-3">
						<div class="flex items-center gap-2">
							<span class="material-symbols-outlined text-slate-400 text-sm">terminal</span>
							<span class="text-xs font-bold uppercase tracking-wider text-slate-300">Log Runner</span>
							<span id="runner-status" class="hidden rounded-full bg-emerald-500/15 px-2 py-0.5 text-[11px] font-bold text-emerald-300">RUNNING</span>
						</div>
						<button onclick="clearRunnerLog()" class="text-xs font-bold text-slate-400 hover:text-white">Xóa log</button>
					</div>
					<div id="runner-log" class="h-80 overflow-y-auto px-4 py-3 font-mono text-xs leading-5 text-slate-300"></div>
				</div>

				<div class="flex flex-wrap gap-2 text-xs text-slate-500">
					<span class="rounded-full bg-slate-50 px-3 py-1 font-semibold">Map page đã nhúng runner</span>
					<span class="rounded-full bg-slate-50 px-3 py-1 font-semibold">Stream bằng SSE</span>
					<span class="rounded-full bg-slate-50 px-3 py-1 font-semibold">Endpoint: /LoadTest/Run</span>
				</div>
			</div>
		</section>

		<aside class="space-y-6">
			<section class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
				<h2 class="text-base font-black text-slate-900">Display Targets</h2>
				<p class="mt-1 text-sm text-slate-500">Nơi hiển thị runner để thao tác nhanh.</p>
				<div class="mt-4 space-y-3">
					<a asp-area="Admin" asp-controller="AdminDashboard" asp-action="Map"
						 class="flex items-center justify-between rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 transition-all hover:border-orange-300 hover:bg-orange-50">
						<div>
							<div class="text-sm font-bold text-slate-900">Bản đồ toàn hệ thống</div>
							<div class="text-xs text-slate-500">Có panel Load Test Runner ngay trên map</div>
						</div>
						<span class="material-symbols-outlined text-orange-600">north_east</span>
					</a>
					<a asp-controller="LoadTest" asp-action="Index" asp-area=""
						 class="flex items-center justify-between rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 transition-all hover:border-orange-300 hover:bg-orange-50">
						<div>
							<div class="text-sm font-bold text-slate-900">Trang Load Test riêng</div>
							<div class="text-xs text-slate-500">Xem timeline, summary và output đầy đủ</div>
						</div>
						<span class="material-symbols-outlined text-orange-600">north_east</span>
					</a>
				</div>
			</section>

			<section class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
				<h2 class="text-base font-black text-slate-900">Ghi chú test</h2>
				<div class="mt-3 space-y-3 text-sm text-slate-600">
					<div class="rounded-2xl bg-amber-50 px-4 py-3">
						<div class="font-bold text-amber-900">POI Concurrent</div>
						<div class="mt-1 text-amber-800/90">Bắn nhiều user vào cùng lúc để đo throughput và độ trễ API.</div>
					</div>
					<div class="rounded-2xl bg-cyan-50 px-4 py-3">
						<div class="font-bold text-cyan-900">Heartbeat 100 Devices</div>
						<div class="mt-1 text-cyan-800/90">Mô phỏng 100 thiết bị gửi heartbeat đồng thời.</div>
					</div>
				</div>
			</section>
		</aside>
	</div>
</div>

<script>
let runnerSource = null;

function appendRunnerLog(message, kind) {
	const log = document.getElementById('runner-log');
	const line = document.createElement('div');
	line.className = 'py-0.5 break-words ' + (kind === 'error' ? 'text-red-400' : kind === 'success' ? 'text-emerald-300' : kind === 'meta' ? 'text-cyan-300' : 'text-slate-300');
	line.textContent = message;
	log.appendChild(line);
	log.scrollTop = log.scrollHeight;
}

function clearRunnerLog() {
	document.getElementById('runner-log').innerHTML = '';
	document.getElementById('runner-status').classList.add('hidden');
}

function setRunnerRunning(running) {
	const status = document.getElementById('runner-status');
	const btn = document.getElementById('runner-start-btn');
	const icon = document.getElementById('runner-btn-icon');
	const text = document.getElementById('runner-btn-text');

	btn.disabled = running;
	if (running) {
		status.classList.remove('hidden');
		icon.textContent = 'hourglass_top';
		text.textContent = 'Đang chạy...';
	} else {
		icon.textContent = 'play_arrow';
		text.textContent = 'Chạy test';
	}
}

function startRunner() {
	const scenario = document.getElementById('runner-scenario').value;
	const baseUrl = document.getElementById('runner-base-url').value.trim() || 'http://localhost:5010';

	if (runnerSource) {
		runnerSource.close();
		runnerSource = null;
	}

	clearRunnerLog();
	setRunnerRunning(true);
	appendRunnerLog(`▶ Starting ${scenario} against ${baseUrl}`, 'meta');

	const url = `/LoadTest/Run?file=${encodeURIComponent(scenario)}&baseUrl=${encodeURIComponent(baseUrl)}`;
	runnerSource = new EventSource(url);

	runnerSource.addEventListener('start', e => appendRunnerLog(e.data, 'meta'));
	runnerSource.addEventListener('log', e => appendRunnerLog(e.data));
	runnerSource.addEventListener('done', e => {
		appendRunnerLog(e.data, e.data === 'PASS' ? 'success' : 'error');
		setRunnerRunning(false);
		document.getElementById('runner-status').classList.remove('hidden');
		document.getElementById('runner-status').textContent = e.data === 'PASS' ? 'PASS' : 'FAIL';
		if (runnerSource) {
			runnerSource.close();
			runnerSource = null;
		}
	});

	runnerSource.onerror = () => {
		appendRunnerLog('Log stream interrupted', 'error');
		setRunnerRunning(false);
		if (runnerSource) {
			runnerSource.close();
			runnerSource = null;
		}
	};
}
</script>
